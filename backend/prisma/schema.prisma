datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
  sales     Sale[]

  @@index([email])
  @@map("users")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  quantity  Int
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("products")
}

model Sale {
  id          Int      @id @default(autoincrement()) @map("SalesID")
  productName String   @map("SName")
  price       Float    @map("SPrice")
  quantity    Int      @map("SQuantity")
  total       Float    @map("Stotal")
  dateOfSale  String   @map("DOS")
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("sales")
}
